# 复制此文件到仓库外部保存（绝不要提交到 GitHub）：
#   macOS / Linux: ~/.config/agent-secrets/sync-skills.env
#   Windows:       %USERPROFILE%\.config\agent-secrets\sync-skills.env

# 可选：手动指定本机克隆的技能仓库路径（留空则自动通过脚本位置向上定位 .git 根目录）
# SKILLS_REPO_DIR=/path/to/your/agent-skills

# 可选：自定义本地敏感词（英文逗号分隔，不区分大小写）
# 命中任意词将直接阻断推送，防止误把个人或业务隐私发到 Public 仓库
# 例如：真实姓名、本机用户名、店铺名、品牌名、私人域名
CUSTOM_REDACT_TERMS=

# 可选：允许出现在公开仓库中的邮箱白名单（英文逗号分隔）
# 例如 GitHub noreply 邮箱
ALLOWED_EMAILS=
