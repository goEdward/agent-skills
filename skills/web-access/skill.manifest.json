{
  "name": "web-access",
  "version": "2.9.1",
  "description": "Web research, fact-checking, static fetching, and authenticated external browser CDP automation for Antigravity and Codex.",
  "agents": ["antigravity", "codex", "claude"],
  "platforms": ["mac", "win", "linux"],
  "entry": "SKILL.md",
  "agentOverrides": {
    "antigravity": "agents/antigravity/SKILL.md",
    "codex": "agents/codex/SKILL.md",
    "claude": "agents/claude/SKILL.md"
  },
  "agentRules": {
    "antigravity": "agents/antigravity/rules"
  },
  "localSecretsTemplate": "templates/config.env.template",
  "localSecretsTarget": "~/.web-access/config.env"
}
