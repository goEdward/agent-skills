# web-access skill 用户偏好配置
# 此文件是模板。首次运行 check-deps.mjs 时会自动复制到 ~/.web-access/config.env（升级不会覆盖）。
#
# 用户长期偏好的默认 Agent 浏览器
# - 留空：Windows 自动选择 Chrome → Edge → Chromium；其它平台询问偏好
# - 设值：固定使用该浏览器；若未检测到对应 toggle 则硬错（不擅自降级）
#
# 合法值：chrome / chrome-canary / chromium / edge（以当前平台支持项为准）
WEB_ACCESS_BROWSER=

# 浏览器 Profile 的内部目录名（例如 Profile 2）
# Chrome / Edge / Chromium 均适用；若该 Profile 未加载则报错，不降级。
WEB_ACCESS_BROWSER_PROFILE=

# 旧版兼容项；新配置请使用 WEB_ACCESS_BROWSER_PROFILE。
WEB_ACCESS_CHROME_PROFILE=

# Chrome Profile 锚点 URL（匹配已打开页面 URL 的片段，例如 x.com/）
# 配置了 WEB_ACCESS_BROWSER_PROFILE 时，锚点只用于排序候选上下文，
# Proxy 还会用 chrome://version 的 Profile Path 做最终身份校验。
WEB_ACCESS_CHROME_ANCHOR_URL=

# 多个正向锚点与排除锚点，使用英文逗号分隔。多锚点配置优先于上面的单锚点兼容项。
# 例：目标 Profile 使用 x.com；工作 Profile 可排除 amazon.com,sellersprite.com,dianxiaomi.com,sellfox.com。
WEB_ACCESS_CHROME_ANCHOR_URLS=
WEB_ACCESS_CHROME_EXCLUDE_URLS=

# 是否允许在 Chrome 拒绝后台创建时使用 window.open 兼容回退。
# 默认关闭，确保 Agent 不会为了 Profile 探测或创建页面抢占窗口焦点。
# 设为 true 后，首次建立 Profile 桥接页时可能短暂切到 Chrome 前台。
# Profile 配置变化后，桥接页解除保留并进入闲置清理，默认可能延迟约 5 分钟回收。
WEB_ACCESS_ALLOW_FOREGROUND_FALLBACK=false

# 用户长期偏好的固定调试端口
# - 留空：按 WEB_ACCESS_BROWSER / 自动询问逻辑选择
# - 设值：固定连接 127.0.0.1:<port>；若端口不通则硬错
# - 若设置了这个值，它优先于 WEB_ACCESS_BROWSER
WEB_ACCESS_DEBUG_PORT=
